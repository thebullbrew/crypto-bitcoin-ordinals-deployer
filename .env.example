# Copy to .env and fill in. Never commit .env.

# Network: testnet or mainnet. ALWAYS practice on testnet first.
BITCOIN_NETWORK=testnet

# Esplora-compatible API for UTXO lookups and fee estimates.
# Defaults: mempool.space (mainnet) / mempool.space/testnet (testnet).
# ORD_API_URL=https://mempool.space/api

# Fee rate in sat/vB. Check a fee estimator before mainnet use.
FEE_RATE_SAT_VB=10

# WIF of the DEDICATED inscription key. Its x-only pubkey becomes the
# internal key of every inscription script. This key authorizes the reveal
# spend, so generate a fresh one per project and never reuse an exchange key.
# This tool only builds UNSIGNED PSBTs — signing happens in your wallet.
WALLET_WIF=

# Address holding the BTC that funds the commit transaction.
# Use an ord-compatible wallet (Sparrow, Xverse, UniSat, …).
FUNDING_ADDRESS=

# Where the inscribed sats are sent by the reveal transaction.
# Defaults to FUNDING_ADDRESS. Must be an ord-compatible receive address.
# INSCRIPTION_DESTINATION_ADDRESS=

# Folder of files to inscribe (images, JSON metadata, …).
ASSETS_DIR=assets

# After the commit confirms, record each txid in out/plan.json (commitTxid per
# item) — the reveal phase reads them from there.
# COMMIT_TXID=
